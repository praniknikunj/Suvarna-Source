## name -> [row on the sheet, seconds per frame (last value repeats), loops?]
const AN := {
	"idle": ["idle", [0.18], true],
	"back": ["idle_back", [0.22], true],
	"walk": ["walk", [0.12], true],
	"run": ["run", [0.08], true],
	"jump": ["jump", [0.09], false],
	"fall": ["fall", [0.1], true],
	"land": ["land", [0.08], false],
	"crouch": ["crouch", [0.07], false],
	"slash": ["slash", [0.07, 0.06, 0.06, 0.08, 0.1, 0.08], false],
	"thrust": ["thrust", [0.06, 0.05, 0.07, 0.1, 0.07, 0.07], false],
	"hurt": ["hurt", [0.12], false],
	"die": ["die", [0.15], false],
	"interact": ["special", [0.35], false],
}

static func dur(n: String, i: int) -> float:
	var d: Array = AN[n][1]
	return d[mini(i, d.size() - 1)]

static func total(n: String) -> float:
	var tot := 0.0
	for i in range(FR[AN[n][0]].size()):
		tot += dur(n, i)
	return tot

static func fidx(n: String, t: float) -> int:
	var cnt: int = FR[AN[n][0]].size()
	var tt := t
	if AN[n][2]:
		tt = fmod(t, total(n))
	var acc := 0.0
	for i in range(cnt):
		acc += dur(n, i)
		if tt < acc:
			return i
	return cnt - 1
